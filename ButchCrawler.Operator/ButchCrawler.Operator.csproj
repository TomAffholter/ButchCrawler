<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Product>History's Web Crawler</Product>
    <Title>History's Web Crawler</Title>
    <AssemblyTitle>History's Web Crawler</AssemblyTitle>
    <Authors>Tom Affholter</Authors>
    <Description>Historical source discovery and research crawler.</Description>
    <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTimestampUtc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ButchCrawler.App\ButchCrawler.App.csproj" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
    <None Remove="Assets\western-about-collage.png" />
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <Resource Include="Assets\western-about-collage.png" />
    <Content Include="..\ButchCrawler.App\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="HistoryCrawler.FirstRun">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
